<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/w_background" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_background" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal"
        android:padding="8dp" android:gravity="center_vertical">
        <ImageView android:id="@+id/w_cover" android:layout_width="wrap_content" android:layout_height="match_parent"
            android:maxWidth="110dp" android:adjustViewBounds="true" android:scaleType="fitCenter" android:contentDescription="App öffnen" />
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical"
            android:layout_marginStart="10dp" android:gravity="center">
            <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
                android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:shadowColor="#99000000" android:shadowRadius="3" />
            <TextView android:id="@+id/w_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
                android:maxLines="1" android:ellipsize="end" android:shadowColor="#99000000" android:shadowRadius="3" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <ImageView android:id="@+id/w_prev" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:contentDescription="Zurück" android:src="@drawable/ic_w_prev" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/w_play" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:contentDescription="Play oder Pause" android:src="@drawable/ic_w_play" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/w_next" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:contentDescription="Weiter" android:src="@drawable/ic_w_next" android:scaleType="fitCenter" />
            </LinearLayout>
            <ProgressBar android:id="@+id/w_progress" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent"
                android:layout_height="3dp" android:max="1000" android:progressDrawable="@drawable/widget_progress" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
